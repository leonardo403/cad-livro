{% extends 'base.html.twig' %}

{% block title %}Assuntos - Cadastro de Livros{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h3 mb-0">Assuntos</h1>
        <a href="{{ path('assunto_new') }}" class="btn btn-primary">+ Novo assunto</a>
    </div>

    {% if assuntos is empty %}
        <div class="alert alert-info">Nenhum assunto cadastrado ainda.</div>
    {% else %}
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle bg-white shadow-sm rounded">
                <thead class="table-dark">
                <tr>
                    <th>Código</th>
                    <th>Descrição</th>
                    <th class="text-end">Ações</th>
                </tr>
                </thead>
                <tbody>
                {% for assunto in assuntos %}
                    <tr>
                        <td>{{ assunto.codAs }}</td>
                        <td>{{ assunto.descricao }}</td>
                        <td class="text-end text-nowrap">
                            <a href="{{ path('assunto_edit', {'id': assunto.codAs}) }}" class="btn btn-sm btn-outline-secondary">Editar</a>
                            <form method="post" action="{{ path('assunto_delete', {'id': assunto.codAs}) }}"
                                  class="d-inline" onsubmit="return confirm('Excluir este assunto?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_assunto_' ~ assunto.codAs) }}">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Excluir</button>
                            </form>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
{% endblock %}