{% extends 'base.html.twig' %}

{% block title %}Relatório de livros por autor - Cadastro de Livros{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h3 mb-0">Relatório de livros por autor</h1>
        <button type="button" class="btn btn-outline-primary" onclick="window.print()">Imprimir</button>
    </div>

    <p class="text-muted">
        Dados gerados a partir da view <code>vw_relatorio_livros</code> ({{ totalLivros }} registros).
        Um livro com vários autores aparece para cada um deles.
    </p>

    {% if porAutor is empty %}
        <div class="alert alert-info">Não há dados para o relatório.</div>
    {% else %}
        <div class="card shadow-sm">
            <div class="card-body">
                {% for autor, linhas in porAutor %}
                    <h2 class="h5 mt-4 border-bottom pb-2">{{ autor }}</h2>
                    <table class="table table-sm table-striped align-middle">
                        <thead>
                        <tr>
                            <th>#</th>
                            <th>Título</th>
                            <th>Editora</th>
                            <th>Edição</th>
                            <th>Ano</th>
                            <th class="text-end">Valor</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for linha in linhas %}
                            <tr>
                                <td>{{ linha.cod_livro }}</td>
                                <td>{{ linha.titulo }}</td>
                                <td>{{ linha.editora ?? '—' }}</td>
                                <td>{{ linha.edicao ?? '—' }}</td>
                                <td>{{ linha.ano_publicacao ?? '—' }}</td>
                                <td class="text-end">R$ {{ linha.valor|number_format(2, ',', '.') }}</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                {% endfor %}
            </div>
        </div>
    {% endif %}
{% endblock %}